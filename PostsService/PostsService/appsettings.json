{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres_posts;Port=5432;Database=postsdb;Username=posts_user;Password=posts_pass"
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "GroupId": "posts-service-group",
    "MaxRetryAttempts": 5,
    "RetryBaseDelay": 2,
    "MessageTimeoutMs": 60000,
    "SocketTimeoutMs": 60000,
    "ReconnectBackoffMs": 5000,
    "ReconnectBackoffMaxMs": 30000,
    "Topics": {
      "Users": "users.events",
      "UsersDlq": "users.events.dlq",
      "Posts": "posts.events",
      "PostsDlq": "posts.events.dlq"
    }
  }
}
