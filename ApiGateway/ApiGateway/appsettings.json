{
  "Keycloak": {
    "Authority": "http://keycloak:8080/realms/widler",
    "Issuer": "http://localhost:8080/realms/widler",
    "Audience": "widler-api",
    "RequireHttpsMetadata": false
  },

  "ReverseProxy": {
    "Routes": {
      "users-get": {
        "ClusterId": "users",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/v1/users",
          "Methods": [
            "GET"
          ]
        }
      },
      "users-get-by-id": {
        "ClusterId": "users",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/v1/users/{id}",
          "Methods": [
            "GET"
          ]
        }
      },
      "users-post": {
        "ClusterId": "users",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/v1/users",
          "Methods": [
            "POST"
          ]
        }
      },
      "users-delete": {
        "ClusterId": "users",
        "AuthorizationPolicy": "Admin",
        "Match": {
          "Path": "/api/v1/users/{id}",
          "Methods": [
            "DELETE"
          ]
        }
      },
      "posts-debug": {
        "ClusterId": "posts",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/v1/posts/cu",
          "Methods": [ "GET" ]
        }
      },
      "posts-get": {
        "ClusterId": "posts",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/v1/posts",
          "Methods": [ "GET" ]
        }
      },
      "posts-get-by-id": {
        "ClusterId": "posts",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/v1/posts/{id}",
          "Methods": [
            "GET"
          ]
        }
      },
      "posts-write": {
        "ClusterId": "posts",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/v1/posts",
          "Methods": [
            "POST",
            "PUT",
            "PATCH"
          ]
        }
      },
      "posts-delete": {
        "ClusterId": "posts",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/v1/posts/{id}",
          "Methods": [
            "DELETE"
          ]
        }
      }
    },

    "Clusters": {
      "users": {
        "Destinations": {
          "users-service": {
            "Address": "http://usersservice:80"
          }
        }
      },

      "posts": {
        "Destinations": {
          "posts-service": {
            "Address": "http://postsservice:80"
          }
        }
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

